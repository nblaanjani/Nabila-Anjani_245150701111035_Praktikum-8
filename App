        NotaBelanja n1 = new NotaBelanja("Teh Botol", 4, 3000);
        NotaBelanja n2 = new NotaBelanja("Roti", 2, 7500);
        NotaBelanja n3 = new NotaBelanja("Susu", 1, 15000);

        NotaBelanja[] belanjaan = {n1, n2, n3};

        Karyawan karyawan1 = new Karyawan(2023001, "Rizal", 3500000, belanjaan);
        karyawan1.tampilkanInfoKaryawan();

